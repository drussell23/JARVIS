#!/bin/sh
# JARVIS pre-push -- host-agnostic launcher for the secret gate.
#
# git runs hooks through a POSIX sh on every platform it supports (Git for
# Windows ships one), so this file is sh, not Python: a `#!/usr/bin/env
# python3` hook dies with "not found" on a Windows host whose `python3` is
# absent -- or, worse, is the Microsoft Store alias, which EXISTS on PATH and
# only fails when run.
#
# So every candidate is PROVEN by running it, never trusted because it was
# found. The first interpreter that actually executes Python 3.8+ wins:
#
#   1. $JARVIS_HOOK_PYTHON            operator override (a path or a command)
#   2. git config jarvis.hookPython   per-repository override
#   3. python3, python, py -3         whatever the host provides
#   4. uv python find                 a uv-managed CPython, if uv is installed
#   5. WSL bridge (Windows only)      the gate runs inside WSL, on /mnt/...
#
# Nothing works: the push is REFUSED with instructions (fail closed).
# The gate itself is pre_push_gate.py, installed beside this file.

hooks_dir=$(cd "$(dirname "$0")" && pwd)
gate="$hooks_dir/pre_push_gate.py"
probe='import sys; sys.exit(0 if sys.version_info >= (3, 8) else 3)'

if [ ! -f "$gate" ]; then
    echo "[pre-push] $gate is missing -- reinstall with:" >&2
    echo "           python3 scripts/install_hooks.py install pre-push" >&2
    exit 1
fi

case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*|Windows_NT) host=windows ;;
    *) host=posix ;;
esac

# Probe with stdin detached, so a probe can never consume the ref list git is
# feeding this hook -- the gate needs every line of it.
works() {
    "$@" -c "$probe" </dev/null >/dev/null 2>&1
}

# Resolution only SETS variables; the single exec happens at top level, where
# "$@" is still the hook's own arguments (inside a function it is not).
#   py_path  -- an interpreter path, run quoted (it may contain spaces)
#   py_cmd   -- a command line, run word-split ("py -3")
py_path=
py_cmd=
resolve() {
    for cand in "$JARVIS_HOOK_PYTHON" "$(git config --get jarvis.hookPython 2>/dev/null)"; do
        [ -n "$cand" ] || continue
        if works "$cand"; then py_path=$cand; return 0; fi
        # shellcheck disable=SC2086 -- deliberate word splitting ("py -3")
        if works $cand; then py_cmd=$cand; return 0; fi
        echo "[pre-push] configured interpreter '$cand' does not run Python 3.8+ -- ignored" >&2
    done
    for cand in python3 python; do
        command -v "$cand" >/dev/null 2>&1 || continue
        if works "$cand"; then py_path=$cand; return 0; fi
    done
    if command -v py >/dev/null 2>&1 && works py -3; then
        py_cmd="py -3"; return 0
    fi
    if command -v uv >/dev/null 2>&1; then
        found=$(uv python find 2>/dev/null)
        if [ -n "$found" ] && [ "$host" = windows ] && command -v cygpath >/dev/null 2>&1; then
            found=$(cygpath -u "$found")
        fi
        if [ -n "$found" ] && works "$found"; then py_path=$found; return 0; fi
    fi
    return 1
}

if resolve; then
    if [ -n "$py_path" ]; then
        exec "$py_path" "$gate" "$@"
    fi
    # shellcheck disable=SC2086
    exec $py_cmd "$gate" "$@"
fi

# The WSL bridge: last, because it is the slowest to start and a native
# interpreter is always preferable. wsl.exe starts in the translated current
# directory (the repository root), so the gate's git calls see the same repo.
if [ "$host" = windows ] && command -v wsl.exe >/dev/null 2>&1; then
    distro=${JARVIS_HOOK_WSL_DISTRO:+-d $JARVIS_HOOK_WSL_DISTRO}
    # MSYS rewrites POSIX-looking arguments passed to a native .exe
    # (/mnt/c/... -> C:/Program Files/Git/mnt/c/...). Switch that off for
    # every argument, the gate path and the remote URL alike.
    export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'
    win_gate=$(cygpath -w "$gate" 2>/dev/null || echo "$gate")
    # </dev/null is load-bearing: wsl.exe forwards and CONSUMES its parent's
    # stdin, so an undetached helper call swallows git's ref list and the gate
    # then sees nothing to scan and passes -- found live, silently exit 0.
    # shellcheck disable=SC2086 -- $distro is empty or "-d NAME"
    wsl_gate=$(wsl.exe $distro -e wslpath -u "$win_gate" </dev/null 2>/dev/null | tr -d '\r')
    # shellcheck disable=SC2086
    if [ -n "$wsl_gate" ] && wsl.exe $distro -e python3 -c "$probe" </dev/null >/dev/null 2>&1; then
        # shellcheck disable=SC2086
        exec wsl.exe $distro -e python3 "$wsl_gate" "$@"
    fi
fi

cat >&2 <<'EOF'
[pre-push] JARVIS secret gate: no working Python 3.8+ interpreter found.
           Tried $JARVIS_HOOK_PYTHON, git config jarvis.hookPython, python3,
           python, py -3, `uv python find`, and (on Windows) the WSL bridge.
           A Microsoft Store "python" alias does not count -- it only opens
           the Store. Point the gate at a real interpreter:
               git config jarvis.hookPython "C:/path/to/python.exe"
           Push refused (fail closed). To bypass once: git push --no-verify
EOF
exit 1
