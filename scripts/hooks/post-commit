#!/usr/bin/env bash
# Mirror every commit in this (WSL) clone into the Windows clone, so the tree
# VS Code renders is never behind the tree the organism actually commits to.
#
# The two clones drifted twice in one session: work landed in WSL and the
# operator saw an unchanged VS Code. Remembering to sync by hand is not a
# mechanism -- and the AUTONOMOUS commits (auto_committer) have no human in the
# loop to remember at all, which is exactly the case that matters.
#
# The Windows clone has `receive.denyCurrentBranch = updateInstead`, so a push
# into its CHECKED-OUT branch updates its working tree as well as the ref.
# That config also makes git REFUSE when the Windows tree is dirty, so this can
# never clobber uncommitted work over there -- it just declines and says so.
#
# This is a LOCAL filesystem push (/mnt/c/...). It is not an outward-facing act
# and is unrelated to the zero-push air-gap in remote_push_guard.py, which
# governs pushes to REMOTES.
#
# Always exits 0: a mirror that fails must never fail the commit that
# succeeded.

set -u

MIRROR_REMOTE="${OV_MIRROR_REMOTE:-windows}"

# Opt out for a single commit with OV_SKIP_MIRROR=1 git commit ...
if [ "${OV_SKIP_MIRROR:-}" = "1" ]; then
    exit 0
fi

if ! git remote get-url "$MIRROR_REMOTE" >/dev/null 2>&1; then
    exit 0   # no mirror configured on this clone; nothing to do
fi

BRANCH="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
if [ -z "$BRANCH" ]; then
    exit 0   # detached HEAD (a worktree mid-rebase): nothing meaningful to mirror
fi

# THE SILENT FAILURE THIS GUARD EXISTS FOR.
#
# `updateInstead` refreshes the target's WORKING TREE only when the pushed
# branch IS the branch that tree has checked out. Push `main` at a clone
# sitting on `some/feature` and git updates the ref, reports success, and
# leaves every file on disk untouched. The push genuinely succeeded; the
# mirror did not.
#
# That is exactly what happened: the Windows clone was left on a session
# branch, twelve commits of `main` mirrored "successfully", and `ov` --
# which is an editable install pointing AT that tree -- kept executing a
# four-commit-stale AST while this hook printed "VS Code tree updated"
# each time. A success that is not one is worse than a refusal, because
# nobody goes looking.
#
# Asked BEFORE the push so the operator is told what will happen, not what
# already silently did. An unreachable target answers "" and is handled by
# the push's own error path below.
TARGET_BRANCH="$(git --git-dir="$(git remote get-url "$MIRROR_REMOTE")/.git" \
    symbolic-ref --quiet --short HEAD 2>/dev/null || true)"

if [ -n "$TARGET_BRANCH" ] && [ "$TARGET_BRANCH" != "$BRANCH" ]; then
    echo "[mirror] MirrorDesyncFault: the $MIRROR_REMOTE tree is on '$TARGET_BRANCH'," >&2
    echo "[mirror]   but this commit is on '$BRANCH'." >&2
    echo "[mirror]   git will update the REF and leave the working tree" >&2
    echo "[mirror]   untouched -- VS Code, and anything running from that" >&2
    echo "[mirror]   tree (the 'ov' editable install), keep executing STALE" >&2
    echo "[mirror]   code while reporting success." >&2
    echo "[mirror]   fix, in the Windows clone:" >&2
    echo "[mirror]     git -C \"\$(git remote get-url $MIRROR_REMOTE)\" checkout $BRANCH" >&2
    echo "[mirror]   then re-mirror:" >&2
    echo "[mirror]     git -C \"$(pwd)\" push $MIRROR_REMOTE $BRANCH" >&2
    # Exit 1 is ADVISORY: git ignores post-commit's status, and it must --
    # the commit already succeeded and is valid. The value is the loud
    # stderr above and a non-zero status for any wrapper that checks.
    exit 1
fi

OUT="$(git push "$MIRROR_REMOTE" "$BRANCH" 2>&1)"
RC=$?
if [ $RC -eq 0 ]; then
    echo "[mirror] $BRANCH -> $MIRROR_REMOTE (VS Code tree updated)"
else
    # The common, expected refusal: the Windows tree has uncommitted changes.
    echo "[mirror] NOT mirrored to $MIRROR_REMOTE -- VS Code is now BEHIND." >&2
    echo "$OUT" | sed 's/^/[mirror]   /' >&2
    echo "[mirror]   fix: commit/stash in the Windows clone, then:" >&2
    echo "[mirror]   git -C /home/jarvis_svc/jarvis push $MIRROR_REMOTE $BRANCH" >&2
fi
exit 0
